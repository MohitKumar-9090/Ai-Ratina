# Comma-separated list of allowed CORS origins and regex pattern
CORS_ORIGINS=https://ai-ratina.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://ai-ratina-.*\.vercel\.app

# Cloudinary Credentials (FastAPI backend only - NEVER expose in frontend!)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
